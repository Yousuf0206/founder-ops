# Lumo Grow — environment template
# Copy to .env for development. NEVER commit .env. (Constitution IX)
#
# Only NEXT_PUBLIC_* values reach the browser. Everything else is server-only.
# `npm run check:public-env` fails the build if a secret ever gains that prefix.

# --- Supabase: safe for the browser -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Supabase: SERVER ONLY ---------------------------------------------------
# Bypasses RLS. Used only by the seed script and trusted server routes.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- AI provider: SERVER ONLY (Phase 2) --------------------------------------
# The provider is selected here, not in code. See lib/ai/provider.ts.
AI_PROVIDER=openrouter
AI_API_KEY=<provider-key>
AI_MODEL=<cheap-default-model>

# --- Email: SERVER ONLY (Phase 4) --------------------------------------------
# The only outbound path in the product: high-intent lead alerts to the team.
RESEND_API_KEY=<resend-key>
NOTIFY_FROM_EMAIL=ops@yourdomain.com

# --- Plans (decisions §6) — entitlements are config, not billing -------------
# Plan given to self-serve workspaces: solo | team | business. Unset = solo.
# An invalid value fails loudly rather than handing out the wrong plan.
DEFAULT_PLAN=solo

# --- Site ---------------------------------------------------------------------
# Used to build magic-link and invitation redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI provider (continued) --------------------------------------------------
# Only needed when AI_PROVIDER=openai-compatible.
AI_BASE_URL=

# --- Publishing: SERVER ONLY (002 Phase 2) -----------------------------------
# 32 random bytes, base64. Seals OAuth tokens at rest (AES-256-GCM). Rotating it
# makes every stored token unreadable, so accounts must reconnect.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTOR_TOKEN_KEY=<32-byte-base64-key>
# LinkedIn app with "Sign In with LinkedIn using OpenID Connect" and "Share on
# LinkedIn". Redirect URL: <site>/api/ops/connections/linkedin/callback
LINKEDIN_CLIENT_ID=<linkedin-client-id>
LINKEDIN_CLIENT_SECRET=<linkedin-client-secret>
# An ACTIVE LinkedIn API version, YYYYMM. Versions are retired; check LinkedIn's docs.
LINKEDIN_API_VERSION=<YYYYMM>
# Vercel Cron sends this as a bearer token to /api/ops/cron/publish-due.
CRON_SECRET=<long-random-string>

# --- Tests -------------------------------------------------------------------
# Local Supabase instance used by tests/integration. Never point at production.
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_ANON_KEY=<local-anon-key>
TEST_SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>
# Opt-ins (see tests/helpers/supabase.ts). Tests create and delete their own
# @example.test users and workspaces; a crashed run can leave residue.
# TEST_SUPABASE_ALLOW_REMOTE=true       # a dedicated remote test project
# TEST_SUPABASE_ALLOW_APP_PROJECT=true  # TEST_SUPABASE_URL equals NEXT_PUBLIC_SUPABASE_URL
